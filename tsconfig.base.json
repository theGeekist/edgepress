{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@geekist/edgepress/domain": ["./packages/domain/src"],
      "@geekist/edgepress/domain/*": ["./packages/domain/src/*"],
      "@geekist/edgepress/contracts": ["./packages/contracts/src"],
      "@geekist/edgepress/contracts/*": ["./packages/contracts/src/*"],
      "@geekist/edgepress/ports": ["./packages/ports/src"],
      "@geekist/edgepress/ports/*": ["./packages/ports/src/*"],
      "@geekist/edgepress/hooks": ["./packages/hooks/src"],
      "@geekist/edgepress/hooks/*": ["./packages/hooks/src/*"],
      "@geekist/edgepress/publish": ["./packages/publish/src"],
      "@geekist/edgepress/publish/*": ["./packages/publish/src/*"],
      "@geekist/edgepress/sdk": ["./packages/sdk/src"],
      "@geekist/edgepress/sdk/*": ["./packages/sdk/src/*"],
      "@geekist/edgepress/testing": ["./packages/testing/src"],
      "@geekist/edgepress/testing/*": ["./packages/testing/src/*"],
      "@geekist/edgepress/cloudflare": ["./packages/cloudflare/src"],
      "@geekist/edgepress/cloudflare/*": ["./packages/cloudflare/src/*"],
      "@geekist/edgepress/cap-wp-core": ["./packages/cap-wp-core/src"],
      "@geekist/edgepress/cap-auth": ["./packages/cap-auth/src"],
      "@geekist/edgepress/cap-content-model": ["./packages/cap-content-model/src"],
      "@geekist/edgepress/cap-document": ["./packages/cap-document/src"],
      "@geekist/edgepress/cap-form": ["./packages/cap-form/src"],
      "@geekist/edgepress/cap-media": ["./packages/cap-media/src"],
      "@geekist/edgepress/cap-navigation": ["./packages/cap-navigation/src"],
      "@geekist/edgepress/cap-preview": ["./packages/cap-preview/src"],
      "@geekist/edgepress/cap-private": ["./packages/cap-private/src"],
      "@geekist/edgepress/cap-publish": ["./packages/cap-publish/src"],
      "@geekist/edgepress/platform-api-core": ["./packages/platform-api-core/src"],
      "@geekist/edgepress/platform-api-core/*": ["./packages/platform-api-core/src/*"]
    }
  }
}
