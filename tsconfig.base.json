{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@geekist/edgepress/domain": ["./packages/domain/src"],
      "@geekist/edgepress/domain/*": ["./packages/domain/src/*"],
      "@geekist/edgepress/hooks": ["./packages/hooks/src"],
      "@geekist/edgepress/hooks/*": ["./packages/hooks/src/*"],
      "@geekist/edgepress/api-orchestration": ["./apps/api/src/orchestration"],
      "@geekist/edgepress/api-orchestration/*": ["./apps/api/src/orchestration/*"],
      "@geekist/edgepress/api-handler": ["./apps/api/src/app/create-api-handler.js"],
      "@geekist/edgepress/admin-api-client": ["./apps/admin-web/src/adapters/api-client.js"],
      "@geekist/edgepress/admin-editor-shell": ["./apps/admin-web/src/features/editor/shell.js"],
      "@geekist/edgepress/admin-editor-store": ["./apps/admin-web/src/features/editor/gutenberg-integration.js"],
      "@geekist/edgepress/testing": ["./packages/testing/src"],
      "@geekist/edgepress/testing/*": ["./packages/testing/src/*"],
      "@geekist/edgepress/cloudflare": ["./packages/cloudflare/src"],
      "@geekist/edgepress/cloudflare/*": ["./packages/cloudflare/src/*"],
      "@geekist/edgepress/wp-core": ["./packages/wp-core/src"],
      "@geekist/edgepress/auth": ["./packages/auth/src"],
      "@geekist/edgepress/content": ["./packages/content/src"],
      "@geekist/edgepress/api-core": ["./packages/api-core/src"],
      "@geekist/edgepress/api-core/*": ["./packages/api-core/src/*"]
    }
  }
}
